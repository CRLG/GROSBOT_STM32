; _____________________________________________________________________________
; Configuration de demonstration du POC "hot-reload de la logique robot Simulia".
;
; Copiee telle quelle dans <clone>/build_poc/Config/EEPROM.ini, elle rend un clone
; fonctionnel "out of the box" : aucun chemin a editer, aucun chemin absolu, aucune
; dependance au poste de developpement.
;
; Deux regles de resolution des chemins relatifs coexistent (cf. CLAUDE.md du clone) :
;   - generated_pathfilename, build_robot_logic_command, config_specifique_coupe_path,
;     blockbot_path et robot_logic_lib_path sont ancres sur le REPERTOIRE DE L'EXECUTABLE
;     (= build_poc, place a la racine du clone) ;
;   - les autres chemins relatifs (default_path_*, launch_and_program_command) restent
;     resolus par rapport au repertoire de lancement, comportement historique inchange.
; Dans le flux de demonstration (Simulia lance depuis build_poc) les deux coincident.
;
; Seuls BlockBotLab, SimuBot et Simulia sont visibles au lancement : ce sont les trois
; fenetres de la demonstration. Les autres modules restent accessibles par le menu.
; _____________________________________________________________________________

[ActuatorSequencer]
background_color=@Variant(\0\0\0\x43\x1\xff\xff\xf0\xf0\xf0\xf0\xf0\xf0\0\0)
; Chemins relatifs au repertoire de lancement (build_poc) -> pointent le clone courant.
default_path_modelia=../Soft_STM32/CM7/Modelia
default_path_softmbed=../Soft_STM32
geometry=@Rect(50 64 1067 785)
niveau_trace=4294967295
visible=false

[DataGraph]
background_color=@Variant(\0\0\0\x43\x1\xff\xff\xf0\xf0\xf0\xf0\xf0\xf0\0\0)
datalist_logged=@Invalid()
geometry=@Rect(50 64 739 431)
niveau_trace=4294967295
visible=false

[DataPlayer]
background_color=@Variant(\0\0\0\x43\x1\xff\xff\xf0\xf0\xf0\xf0\xf0\xf0\0\0)
default_signal_path=./
geometry=@Rect(50 64 425 381)
niveau_trace=4294967295
visible=false

[DataView]
background_color=@Variant(\0\0\0\x43\x1\xff\xff\xf0\xf0\xf0\xf0\xf0\xf0\0\0)
datalist_logged=PosTeta_robot, teta_pos
geometry=@Rect(50 64 838 729)
niveau_trace=4294967295
visible=false

[ExternalControler]
background_color=@Variant(\0\0\0\x43\x1\xff\xff\xf0\xf0\xf0\xf0\xf0\xf0\0\0)
geometry=@Rect(50 64 150 150)
niveau_trace=4294967295
visible=false

[Joystick]
niveau_trace=4294967295

[MainWindow]
geometry=@Rect(50 64 350 150)
visible=true

[ModuleDesigner]
background_color=@Variant(\0\0\0\x43\x1\xff\xff\xf0\xf0\xf0\xf0\xf0\xf0\0\0)
geometry=@Rect(0 0 489 356)
niveau_trace=4294967295
repertoire_projet=./
visible=false

[SimuBot]
Theta_asserv_init_1_bot1=-1.57
Theta_asserv_init_1_bot2=0.
Theta_asserv_init_2_bot1=1.57
Theta_asserv_init_2_bot2=0.
Theta_init_1_bot1=-1.57
Theta_init_1_bot2=1.57
Theta_init_2_bot1=-1.57
Theta_init_2_bot2=1.57
X_init_1_bot1=42
X_init_1_bot2=177
X_init_2_bot1=258
X_init_2_bot2=123
Y_init_1_bot1=172.5
Y_init_1_bot2=20
Y_init_2_bot1=172.5
Y_init_2_bot2=20
background_color=@Variant(\0\0\0\x43\x1\xff\xff\xf0\xf0\xf0\xf0\xf0\xf0\0\0)
geometry=@Rect(70 64 1850 1016)
; 0=TEST, 1=VISU, 2=SIMU. TEST est le POINT DE DEPART de la demonstration, qui parcourt
; ensuite les trois modes : TEST (construction de la strategie par double-clic, envoyee a
; BlockBotLab), puis VISU (execution de la strategie en HIL depuis BlockBotLab), puis SIMU
; (compilation de la logique robot et execution depuis Simulia, avec hot-reload).
; En TEST, penser a cocher "setSequence" dans SimuBot : c'est cette case qui arme l'envoi
; de la position vers BlockBotLab au double-clic (non memorisee en EEPROM, elle n'est
; activable qu'en mode TEST).
mode_visu=0
niveau_trace=4294967295
use_2_bots=false
visible=true
zoom=3

[BlockBotLab]
background_color=@Variant(\0\0\0\x43\x1\xff\xff\xf0\xf0\xf0\xf0\xf0\xf0\0\0)
; false = mode industriel : BlockBot est charge depuis le bundle embarque en ressource Qt
; (qrc), donc aucun npm ni depot BlockBot necessaire pour la demonstration.
blockbot_devmode=false
blockbot_mode=expert
; Utilise UNIQUEMENT si blockbot_devmode=true (repertoire de travail du serveur webpack).
; Convention d'atelier : depot BlockBot a cote du clone GROSBOT_STM32.
blockbot_path=../../BlockBot
blockbot_port=8080
; "~" est developpe en repertoire home de l'utilisateur courant -> portable d'un poste a
; l'autre. Vide = aucun nettoyage du cache QtWebEngine au demarrage.
clean_cache_directory=~/.local/share/Simulia/QtWebEngine
config_specifique_coupe_path=../Soft_STM32/CM7/Includes/ConfigSpecifiqueCoupe.h
generated_pathfilename=../Soft_STM32/CM7/Modelia
geometry=@Rect(70 64 1850 1016)
http_server_port=3001
launch_and_program_command=make install -j4 -C ../Soft_STM32/CM7/
niveau_trace=4294967295
visible=true
; ---- POC hot-reload ----
; Script de build de la logique robot, lance par le bouton "Compiler pour Simulia".
build_robot_logic_command=../Simulia/tools/build_robot_logic.sh
; Rechargement a chaud automatique dans Simulia des qu'une compilation reussit.
auto_reload_simulia=true

[Simulia]
background_color=@Variant(\0\0\0\x43\x1\xff\xff\xf0\xf0\xf0\xf0\xf0\xf0\0\0)
choix_strategie=1
couleur_equipe=0
geometry=@Rect(1291 65 623 560)
niveau_trace=4294967295
origine_donnees_detection_obstacle=2
origine_donnees_telemetres=0
; Repertoire scanne pour les librobotlogic_*.so ET repertoire de depot du .so compile.
; "." = le repertoire de l'executable (build_poc).
robot_logic_lib_path=.
visible=true

[UserGuides]
background_color=@Variant(\0\0\0\x43\x1\xff\xff\xf0\xf0\xf0\xf0\xf0\xf0\0\0)
niveau_trace=4294967295

[csvDataLogger]
background_color=@Variant(\0\0\0\x43\x1\xff\xff\xf0\xf0\xf0\xf0\xf0\xf0\0\0)
datalist_logged=@Invalid()
enable_log_on_value_changed=false
enable_log_on_value_updated=false
enable_log_periodic=true
geometry=@Rect(50 64 411 249)
log_period=1000
niveau_trace=4294967295
visible=false
